        <object placeholders="1" c4Type="Relationship" c4Technology="Redis" c4Description="Сохраняет состояние&lt;br&gt;и захватывает опрос" label="&lt;div style=&quot;text-align: left&quot;&gt;&lt;div style=&quot;text-align: center&quot;&gt;&lt;b&gt;%c4Description%&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center&quot;&gt;[%c4Technology%]&lt;/div&gt;&lt;/div&gt;" id="osago-shared-state">
