        <mxCell id="fo" parent="1" style="html=1;whiteSpace=wrap;rounded=1;absoluteArcSize=1;arcSize=16;fillColor=none;strokeColor=#5282ff;strokeWidth=1.5;verticalAlign=bottom;align=left;spacingLeft=10;spacingBottom=4;fontSize=11;fontStyle=1;" value="" vertex="1">
